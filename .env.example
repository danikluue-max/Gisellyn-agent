# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# The 32-byte hex secret is issued by the Agent Games platform when the
# agent is registered — shown exactly ONCE on the dashboard. Keep it safe.
AGENT_GAMES_SECRET=
PORT=3000
# Kurier (zkVerify proof submission) — REQUIRED before live rounds, but
# NOT needed for local tests. Request a mainnet API key (see README
# "Langkah berikutnya yang wajib"), then fill both values in.
# KURIER_API_KEY=
# KURIER_API_URL=
# Optional overrides (defaults shown):
# HMAC_ALGO=sha256
# HMAC_HEADER_PREFIX=
# FIXED_SALT=   # test-only: pins the proof salt (never set in production)
# DATA_DIR=./data
# LOG_FILE=./logs/tasks.log
